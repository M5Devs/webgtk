# Minimal stand-in for //third_party/ffmpeg/ffmpeg_options.gni.
# Stub created by scripts/patch_gn_stubs.sh for the pruned engine archive.
#
# The real file is generated from the FFmpeg build configuration and carries a
# long list of codec/capability flags. The archive drops //third_party/ffmpeg
# entirely; //media/BUILD.gn imports this for two values, so declare just those.
# ffmpeg_branding must be "Chromium" because the default build has
# proprietary_codecs disabled, which //media/BUILD.gn asserts.
declare_args() {
  ffmpeg_branding = "Chromium"
  ffmpeg_regression_tests = false
}
