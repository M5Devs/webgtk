# Build output
build/
build-*/
out/
cmake-build-*/

# g-ir-scanner leaves a probe translation unit in the source tree on failure
g-ir-cpp-*.c

# Vendored engine and downloaded archives
chromium/
engine/
*.tar.gz
*.tar.xz
*.zip

# Agent workspace state
.openhands/

# Editor and OS noise
.vscode/
.idea/
*.swp
.DS_Store

# Python bytecode
__pycache__/
*.pyc

# ...and finally, the committed GN stub snapshot must win over every rule
# above (its paths mirror engine paths like "build/" and "chrome/.../chromium/").
!scripts/gn_stubs/
!scripts/gn_stubs/**
